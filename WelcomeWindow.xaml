<Window x:Class="MiniPlayer.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mini Player"
        Icon="Assets/app.ico"
        Width="480" Height="330"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#1E1F22"
        FontFamily="Segoe UI">

    <!-- No title bar; invisible resize edges. The whole window is a live demo: drag it, pinch it. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- No dotted keyboard-focus rectangles -->
        <Style TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E6E6E6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 3D keyboard key: a lit top face sitting on a darker base -->
        <Style x:Key="KeyCap" TargetType="ContentControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <Grid.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="3" Direction="270" Opacity="0.55" Color="Black"/>
                            </Grid.Effect>
                            <!-- base (the key's side) -->
                            <Border CornerRadius="7" Background="#15161A" Margin="0,4,0,0"/>
                            <!-- top face -->
                            <Border CornerRadius="7" Margin="0,0,0,4" BorderThickness="1" Padding="10,4,10,5" MinWidth="34">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#50545E" Offset="0"/>
                                        <GradientStop Color="#363940" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#7A808C" Offset="0"/>
                                        <GradientStop Color="#2A2C32" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  TextElement.Foreground="#F4F5F7" TextElement.FontSize="13"
                                                  TextElement.FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Plus" TargetType="TextBlock">
            <Setter Property="Text" Value="+"/>
            <Setter Property="Foreground" Value="#6E727A"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="5,0,5,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Glossy blue gradient button with a soft shadow -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                            <Border x:Name="Face" CornerRadius="10">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#5E8BFF" Offset="0"/>
                                        <GradientStop Color="#2F2CF2" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="5" Direction="270" Opacity="0.5" Color="Black"/>
                                </Border.Effect>
                            </Border>
                            <!-- inner glossy edge, bright at the top -->
                            <Border CornerRadius="10" BorderThickness="1" IsHitTestVisible="False">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#99FFFFFF" Offset="0"/>
                                        <GradientStop Color="#22FFFFFF" Offset="0.45"/>
                                        <GradientStop Color="#08FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                            </Border>
                            <TextBlock Text="{TemplateBinding Content}" Foreground="White" FontSize="15" FontWeight="Medium"
                                       HorizontalAlignment="Center" Margin="30,10"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#7A9EFF" Offset="0"/>
                                            <GradientStop Color="#4643FF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Face" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#4F7BF2" Offset="0"/>
                                            <GradientStop Color="#2522D8" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="6" Background="Transparent" Width="30" Height="30">
                            <TextBlock Text="✕" Foreground="#8A8D93" FontSize="13" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2E3036"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Everything scales together with the window -->
    <Viewbox Stretch="Uniform">
        <Grid x:Name="Design" Width="480">
            <Button Style="{StaticResource CloseButton}" Click="OnGotIt"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0"/>

            <StackPanel Margin="30,26,30,26">
                <TextBlock Text="Welcome!" FontSize="28" FontWeight="SemiBold" Foreground="White"/>
                <TextBlock Text="Keep any window playing in a corner while you work."
                           Foreground="#A0A3A8" Margin="0,4,0,24"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="168"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ContentControl Style="{StaticResource KeyCap}" Content="Ctrl"/>
                        <TextBlock Style="{StaticResource Plus}"/>
                        <ContentControl Style="{StaticResource KeyCap}" Content="Alt"/>
                        <TextBlock Style="{StaticResource Plus}"/>
                        <ContentControl Style="{StaticResource KeyCap}" Content="P"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="Pop out a window (again to put back)"/>

                    <TextBlock Grid.Row="1" Text="🤏" FontSize="18" Margin="4,0,0,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Pinch on the touchpad to resize"/>

                    <TextBlock Grid.Row="2" Text="👆" FontSize="18" Margin="4,0,0,0"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Click to use the app · drag to move"/>
                </Grid>

                <TextBlock Text="Try it here: drag this window, or pinch to resize it."
                           Foreground="#7FA6FF" FontSize="13" Margin="0,20,0,0"/>

                <DockPanel Margin="0,22,0,0">
                    <CheckBox x:Name="DontShowAgain" Content="Don't show again" Foreground="#A0A3A8"
                              VerticalAlignment="Center" DockPanel.Dock="Left"/>
                    <Button Content="Got it" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                            IsDefault="True" Click="OnGotIt"/>
                </DockPanel>
            </StackPanel>
        </Grid>
    </Viewbox>
</Window>
